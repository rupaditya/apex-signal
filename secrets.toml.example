# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Everything below is FREE (no credit card). You need at least ONE LLM key.

GEMINI_API_KEY = "..."      # https://aistudio.google.com/apikey   (primary LLM)
GROQ_API_KEY   = "..."      # https://console.groq.com/keys       (backup LLM)
OPENROUTER_API_KEY = "..."  # https://openrouter.ai/keys          (last-resort LLM, free models only, ~50 req/day)
TAVILY_API_KEY = "tvly-..." # https://app.tavily.com               (primary search, 1,000/month)
SERPER_API_KEY = "..."      # https://serper.dev                   (backup search, one-time free queries)
# With no search key at all, keyless DuckDuckGo is used.

# Optional overrides
# GEMINI_MODEL = "gemini-3-flash-preview"
# GROQ_MODEL = "openai/gpt-oss-120b"
# OPENROUTER_MODEL = "openrouter/free"
